{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soldierking04d/fincore-reliability-lab/reports/evaluations/run-index.schema.json",
  "title": "FinCore sanitized repeated-run index",
  "type": "object",
  "required": ["benchmark", "generatedAt", "plannedRuns", "completedRuns", "runs"],
  "properties": {
    "benchmark": {"type": "string"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "plannedRuns": {"type": "integer", "minimum": 1},
    "completedRuns": {"type": "integer", "minimum": 0},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runId", "agent", "model", "taskId", "sourceCommit", "durationSeconds", "status"],
        "properties": {
          "runId": {"type": "string"},
          "agent": {"type": "string"},
          "model": {"type": "string"},
          "taskId": {"type": "string", "pattern": "^FC-[0-9]{3}$"},
          "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "durationSeconds": {"type": "integer", "minimum": 0},
          "status": {"enum": ["clean_pass", "hidden_test_failed", "public_test_failed", "build_failed", "agent_failed"]},
          "cleanPass": {"type": "boolean"},
          "public": {"type": "object"},
          "private": {"type": "object"},
          "usage": {"type": ["object", "null"]},
          "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "vetoes": {"type": "array", "items": {"type": "string"}},
          "privateArtifactSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
