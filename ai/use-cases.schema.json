{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soldierking04d/fincore-reliability-lab/ai/use-cases.schema.json",
  "title": "FinCore AI Use Case Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "policy", "useCases"],
  "properties": {
    "$schema": { "type": "string" },
    "registryVersion": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "required": [
        "defaultDeny",
        "autonomousFinancialWritesAllowed",
        "landedRequiresPublicEvidence",
        "highRiskRequiresHumanApproval",
        "rawProductionDataAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "defaultDeny": { "const": true },
        "autonomousFinancialWritesAllowed": { "const": false },
        "landedRequiresPublicEvidence": { "const": true },
        "highRiskRequiresHumanApproval": { "const": true },
        "rawProductionDataAllowed": { "const": false }
      }
    },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "owner",
          "businessOutcome",
          "riskTier",
          "dataClass",
          "automationLevel",
          "authority",
          "modelContext",
          "valueBaseline",
          "releaseGate",
          "toolAccess",
          "governance",
          "allowedInputs",
          "prohibitedActions",
          "humanApproval",
          "evaluation",
          "fallback",
          "monitoring"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["proposed", "planned", "shadow", "assisted", "landed", "retired"] },
          "owner": { "type": "string", "minLength": 1 },
          "businessOutcome": { "type": "string", "minLength": 1 },
          "riskTier": { "enum": ["low", "medium", "high", "prohibited"] },
          "dataClass": { "enum": ["public", "synthetic_source", "internal_operational", "sensitive_customer", "restricted_financial"] },
          "automationLevel": { "enum": ["advisory", "draft_only", "candidate_generation", "bounded_action"] },
          "authority": { "enum": ["read_only", "isolated_candidate_only", "bounded_tool"] },
          "modelContext": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "providers",
              "modelVersions",
              "promptVersion",
              "retrievalVersion",
              "toolPolicyVersion",
              "dataResidency",
              "retention",
              "trainingUse"
            ],
            "properties": {
              "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "modelVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "promptVersion": { "type": "string", "minLength": 1 },
              "retrievalVersion": { "type": "string", "minLength": 1 },
              "toolPolicyVersion": { "type": "string", "minLength": 1 },
              "dataResidency": { "type": "string", "minLength": 1 },
              "retention": { "type": "string", "minLength": 1 },
              "trainingUse": { "const": "not_authorized" }
            }
          },
          "valueBaseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["currentProcess", "targetOutcome", "unitCostCeiling", "measurementWindow"],
            "properties": {
              "currentProcess": { "type": "string", "minLength": 1 },
              "targetOutcome": { "type": "string", "minLength": 1 },
              "unitCostCeiling": { "type": "string", "minLength": 1 },
              "measurementWindow": { "type": "string", "minLength": 1 }
            }
          },
          "releaseGate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumThresholds", "lastReviewed", "nextReview", "expiresAt"],
            "properties": {
              "minimumThresholds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "lastReviewed": { "type": "string", "format": "date" },
              "nextReview": { "type": "string", "format": "date" },
              "expiresAt": { "type": "string", "format": "date" }
            }
          },
          "toolAccess": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowedTools", "deniedScopes", "killSwitchOwner"],
            "properties": {
              "allowedTools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "deniedScopes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "killSwitchOwner": { "type": "string", "minLength": 1 }
            }
          },
          "governance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legalPrivacyReview", "securityReview", "exitOwner"],
            "properties": {
              "legalPrivacyReview": { "type": "string", "minLength": 1 },
              "securityReview": { "type": "string", "minLength": 1 },
              "exitOwner": { "type": "string", "minLength": 1 }
            }
          },
          "allowedInputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "humanApproval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "gate"],
            "properties": {
              "required": { "type": "boolean" },
              "gate": { "type": "string", "minLength": 1 }
            }
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dataset", "hardVetoes", "evidence"],
            "properties": {
              "dataset": { "type": "string", "minLength": 1 },
              "hardVetoes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          },
          "fallback": { "type": "string", "minLength": 1 },
          "monitoring": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
