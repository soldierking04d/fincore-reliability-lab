{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soldierking04d/fincore-reliability-lab/governance/schemas/audit-evidence.schema.json",
  "title": "FinCore Audit Evidence Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "registryType", "controls"],
  "properties": {
    "$schema": { "type": "string" },
    "registryVersion": { "type": "string", "minLength": 1 },
    "registryType": { "const": "audit_evidence_catalog" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlId", "objective", "owner", "frequency", "linkedRisks", "linkedServices", "testMethod", "evidence", "status", "lastVerified", "nextReview", "retention", "limitations"],
        "properties": {
          "controlId": { "type": "string", "pattern": "^CTRL-[A-Z]+-[0-9]{3}$" },
          "objective": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "frequency": { "type": "string", "minLength": 1 },
          "linkedRisks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "linkedServices": { "$ref": "#/$defs/nonEmptyStrings" },
          "testMethod": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/nonEmptyStrings" },
          "status": { "enum": ["planned", "implemented", "demonstrated", "independently_verified"] },
          "lastVerified": { "$ref": "#/$defs/date" },
          "nextReview": { "$ref": "#/$defs/date" },
          "retention": { "type": "string", "minLength": 1 },
          "limitations": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
