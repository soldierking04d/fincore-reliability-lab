{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soldierking04d/fincore-reliability-lab/governance/schemas/risk-register.schema.json",
  "title": "FinCore Enterprise Risk Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "registryType", "risks"],
  "properties": {
    "$schema": { "type": "string" },
    "registryVersion": { "type": "string", "minLength": 1 },
    "registryType": { "const": "enterprise_risk_register" },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["riskId", "title", "scenario", "category", "status", "probability", "impact", "score", "owner", "linkedServices", "controls", "evidence", "treatment", "dueDate", "lastReviewed", "nextReview", "acceptedBy", "acceptanceExpiresAt", "limitations"],
        "properties": {
          "riskId": { "type": "string", "pattern": "^RISK-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 },
          "category": { "enum": ["security", "reliability", "compliance", "data", "ai", "governance", "capacity", "financial", "vendor"] },
          "status": { "enum": ["active", "monitored", "accepted", "closed"] },
          "probability": { "type": "integer", "minimum": 1, "maximum": 5 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "score": { "type": "integer", "minimum": 1, "maximum": 25 },
          "owner": { "type": "string", "minLength": 1 },
          "linkedServices": { "$ref": "#/$defs/nonEmptyStrings" },
          "controls": { "$ref": "#/$defs/nonEmptyStrings" },
          "evidence": { "$ref": "#/$defs/nonEmptyStrings" },
          "treatment": { "type": "string", "minLength": 1 },
          "dueDate": { "$ref": "#/$defs/date" },
          "lastReviewed": { "$ref": "#/$defs/date" },
          "nextReview": { "$ref": "#/$defs/date" },
          "acceptedBy": { "type": ["string", "null"] },
          "acceptanceExpiresAt": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
          "limitations": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
