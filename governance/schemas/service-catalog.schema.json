{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soldierking04d/fincore-reliability-lab/governance/schemas/service-catalog.schema.json",
  "title": "FinCore Service Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "registryType", "services"],
  "properties": {
    "$schema": { "type": "string" },
    "registryVersion": { "type": "string", "minLength": 1 },
    "registryType": { "const": "service_catalog" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceId", "name", "description", "owner", "deputy", "criticality", "lifecycle", "capabilities", "repository", "repoPaths", "dataClasses", "dependencies", "slo", "runbooks", "lastReviewed", "nextReview"],
        "properties": {
          "serviceId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "deputy": { "type": "string", "minLength": 1 },
          "criticality": { "enum": ["low", "medium", "high", "critical"] },
          "lifecycle": { "enum": ["experimental", "operational", "deprecated", "retired"] },
          "capabilities": { "$ref": "#/$defs/nonEmptyStrings" },
          "repository": { "type": "string", "format": "uri" },
          "repoPaths": { "$ref": "#/$defs/nonEmptyStrings" },
          "dataClasses": { "$ref": "#/$defs/nonEmptyStrings" },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "slo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["availabilityObjective", "latencyObjective", "correctnessObjectives"],
            "properties": {
              "availabilityObjective": { "type": "string", "minLength": 1 },
              "latencyObjective": { "type": "string", "minLength": 1 },
              "correctnessObjectives": { "$ref": "#/$defs/nonEmptyStrings" }
            }
          },
          "runbooks": { "$ref": "#/$defs/nonEmptyStrings" },
          "lastReviewed": { "$ref": "#/$defs/date" },
          "nextReview": { "$ref": "#/$defs/date" }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
