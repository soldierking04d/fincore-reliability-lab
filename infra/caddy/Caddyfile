{
    # 访问 IP 地址时客户端通常不发送 SNI，显式指定默认证书选择目标。
    default_sni 124.223.164.254
}

https://124.223.164.254 {
    # 中国大陆服务器会拦截未备案域名。这里直接为公网 IPv4 申请
    # Let's Encrypt 的短期 IP 证书，由 Caddy 自动续期。
    tls {
        issuer acme {
            profile shortlived
        }
    }

    encode zstd gzip

    reverse_proxy nginx:80 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
    }
}
